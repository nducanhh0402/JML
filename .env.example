# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG JML MARKETPLACE
# Sao chép file này thành .env và điền thông số kết nối của bạn

# Kết nối MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=jml_marketplace

# Cấu hình Ứng dụng Backend ('development' cho local/test, 'production' khi vận hành thật)
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True
ENABLE_DOCS=true

# Cấu hình Secret Key JWT (production bắt buộc >= 32 ký tự ngẫu nhiên)
JWT_SECRET_KEY=jml_super_secret_key_2026_marketplace_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Rate Limit (áp dụng tự động khi APP_ENV=production)
CORS_ORIGINS=https://jml-teal.vercel.app
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60
