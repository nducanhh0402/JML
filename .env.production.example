# MẪU CẤU HÌNH VẬN HÀNH THỰC TẾ (PRODUCTION) — KHÔNG ĐẨY FILE .env THẬT LÊN GIT
APP_ENV=production
DEBUG=False
ENABLE_DOCS=false

# Kết nối MySQL Production (BẮT BUỘC đổi mật khẩu mạnh)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jml_app
MYSQL_PASSWORD=THAY_BANG_MAT_KHAU_MYSQL_MANH
MYSQL_DB=jml_marketplace

# BẮT BUỘC tạo chuỗi ngẫu nhiên >= 32 ký tự (VD: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=THAY_BANG_CHUOI_NGU_NHIEN_IT_NHAT_32_KY_TU
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Chỉ cho phép domain frontend thật gọi API (phân tách bằng dấu phẩy nếu nhiều domain)
CORS_ORIGINS=https://jml-teal.vercel.app

# Giới hạn số lần POST /api/auth/login và /register trên mỗi IP
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60
